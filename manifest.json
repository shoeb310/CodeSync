{
  "manifest_version": 3,
  "name": "CodeSync Tracker",
  "version": "1.0",
  "description": "Auto-commits accepted solutions to my private GitHub tracker.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.github.com/*",
    "https://leetcode.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["leetcode.js"],
      "run_at": "document_idle"
    }
  ]
}